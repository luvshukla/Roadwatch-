<script>

/* =====================================================
   VARIABLES
===================================================== */

let latitude = null;
let longitude = null;
let accuracy = null;

let areaName = "Unknown";
let cityName = "Unknown";
let stateName = "Madhya Pradesh";

let photoData = null;

let cameraStream = null;

let currentFacingMode = "environment";

let roadMap = null;
let userMarker = null;

let currentReport = null;


/* =====================================================
   GOVERNMENT LINKS
===================================================== */

const MP_COMPLAINT =
"https://www.cmhelpline.mp.gov.in/Public/OnlineComplaint.aspx";

const MP_STATUS =
"https://www.cmhelpline.mp.gov.in/grievance-status.aspx";

const MP_RAMS =
"https://rams.mp.gov.in/rams/CitizenPortal.jsp";


/* =====================================================
   ELEMENTS
===================================================== */

const video =
document.getElementById("video");

const preview =
document.getElementById("photoPreview");

const placeholder =
document.getElementById("cameraPlaceholder");

const cameraControls =
document.getElementById("cameraControls");

const statusElement =
document.getElementById("status");


/* =====================================================
   STATUS
===================================================== */

function setStatus(text){

statusElement.textContent =
"● " + text;

}


/* =====================================================
   CAMERA
===================================================== */

document
.getElementById("startCameraButton")
.onclick =
startCamera;


async function startCamera(){

if(
!navigator.mediaDevices ||
!navigator.mediaDevices.getUserMedia
){

alert(
"Camera is not supported. Please upload an image."
);

return;

}

stopCamera();

try{

setStatus("Starting camera...");

cameraStream =
await navigator.mediaDevices.getUserMedia({

video:{
facingMode:{
ideal:currentFacingMode
},
width:{
ideal:1280
},
height:{
ideal:720
}
},

audio:false

});

video.srcObject =
cameraStream;

video.style.display =
"block";

preview.style.display =
"none";

placeholder.style.display =
"none";

cameraControls.style.display =
"flex";

document
.getElementById("startCameraButton")
.style.display =
"none";

setStatus("Camera active");

}

catch(error){

console.error(error);

setStatus("Camera unavailable");

alert(
"Camera permission was denied or unavailable."
);

}

}


function stopCamera(){

if(cameraStream){

cameraStream
.getTracks()
.forEach(
track => track.stop()
);

cameraStream = null;

}

}


/* =====================================================
   CAPTURE
===================================================== */

document
.getElementById("captureButton")
.onclick =
capturePhoto;


function capturePhoto(){

if(!cameraStream){

alert("Start the camera first.");

return;

}

const canvas =
document.createElement("canvas");

canvas.width =
video.videoWidth;

canvas.height =
video.videoHeight;

canvas
.getContext("2d")
.drawImage(
video,
0,
0,
canvas.width,
canvas.height
);

photoData =
canvas.toDataURL(
"image/jpeg",
0.88
);

preview.src =
photoData;

preview.style.display =
"block";

video.style.display =
"none";

cameraControls.style.display =
"none";

document
.getElementById("retakeButton")
.style.display =
"block";

stopCamera();

setStatus("Photo captured");

}


/* =====================================================
   SWITCH CAMERA
===================================================== */

document
.getElementById("switchCameraButton")
.onclick =
async function(){

currentFacingMode =
currentFacingMode ===
"environment"
? "user"
: "environment";

await startCamera();

};


/* =====================================================
   RETAKE
===================================================== */

document
.getElementById("retakeButton")
.onclick =
function(){

photoData = null;

preview.src = "";

preview.style.display =
"none";

placeholder.style.display =
"flex";

document
.getElementById("retakeButton")
.style.display =
"none";

document
.getElementById("startCameraButton")
.style.display =
"block";

setStatus("Ready");

};


/* =====================================================
   FILE UPLOAD
===================================================== */

document
.getElementById("fileButton")
.onclick =
function(){

document
.getElementById("fileInput")
.click();

};


document
.getElementById("fileInput")
.onchange =
function(){

const file =
this.files[0];

if(!file)
return;

const reader =
new FileReader();

reader.onload =
function(event){

photoData =
event.target.result;

preview.src =
photoData;

preview.style.display =
"block";

video.style.display =
"none";

placeholder.style.display =
"none";

document
.getElementById("startCameraButton")
.style.display =
"none";

document
.getElementById("retakeButton")
.style.display =
"block";

setStatus("Photo loaded");

};

reader.readAsDataURL(file);

};


/* =====================================================
   SAVE LOCATION
===================================================== */

function saveLocation(){

localStorage.setItem(
"roadwatchLatitude",
latitude
);

localStorage.setItem(
"roadwatchLongitude",
longitude
);

localStorage.setItem(
"roadwatchAccuracy",
accuracy
);

localStorage.setItem(
"roadwatchArea",
areaName
);

localStorage.setItem(
"roadwatchCity",
cityName
);

localStorage.setItem(
"roadwatchState",
stateName
);

}


/* =====================================================
   GET GPS
===================================================== */

document
.getElementById("locationButton")
.onclick =
getLocation;


function getLocation(){

if(!navigator.geolocation){

alert(
"GPS is not supported by this browser."
);

return;

}

setStatus("Getting GPS...");

navigator.geolocation.getCurrentPosition(

function(position){

latitude =
position.coords.latitude;

longitude =
position.coords.longitude;

accuracy =
position.coords.accuracy;


areaName =
"Current GPS Location";

cityName =
"Madhya Pradesh";


document
.getElementById("latitude")
.textContent =
latitude.toFixed(6);

document
.getElementById("longitude")
.textContent =
longitude.toFixed(6);

document
.getElementById("accuracy")
.textContent =
Math.round(accuracy) +
" meters";

document
.getElementById("area")
.textContent =
areaName;

document
.getElementById("city")
.textContent =
cityName;


saveLocation();

markUserLocation();

setStatus(
"Location saved"
);

},

function(error){

console.error(error);

setStatus("GPS unavailable");

alert(
"Please allow location permission and try again."
);

},

{
enableHighAccuracy:true,
timeout:15000,
maximumAge:0
}

);

}


/* =====================================================
   LOAD SAVED LOCATION
===================================================== */

function loadSavedLocation(){

const savedLat =
localStorage.getItem(
"roadwatchLatitude"
);

const savedLng =
localStorage.getItem(
"roadwatchLongitude"
);

if(
!savedLat ||
!savedLng
){

return;

}


latitude =
Number(savedLat);

longitude =
Number(savedLng);

accuracy =
Number(
localStorage.getItem(
"roadwatchAccuracy"
)
) || 0;


areaName =
localStorage.getItem(
"roadwatchArea"
) ||
"Saved Location";

cityName =
localStorage.getItem(
"roadwatchCity"
) ||
"Madhya Pradesh";

stateName =
localStorage.getItem(
"roadwatchState"
) ||
"Madhya Pradesh";


document
.getElementById("latitude")
.textContent =
latitude.toFixed(6);

document
.getElementById("longitude")
.textContent =
longitude.toFixed(6);

document
.getElementById("accuracy")
.textContent =
Math.round(accuracy) +
" meters";

document
.getElementById("area")
.textContent =
areaName;

document
.getElementById("city")
.textContent =
cityName;


setStatus(
"Saved location restored"
);

markUserLocation();

}


/* =====================================================
   MAP
===================================================== */

function initializeMap(){

roadMap =
L.map("roadMap")
.setView(
[22.7196,75.8577],
13
);

L.tileLayer(
"https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
{
attribution:
"&copy; OpenStreetMap contributors"
}
).addTo(roadMap);


const reports = [

{
lat:22.7196,
lng:75.8577,
problem:"Pothole",
severity:"Critical"
},

{
lat:22.7250,
lng:75.8650,
problem:"Road Crack",
severity:"High"
},

{
lat:22.7100,
lng:75.8500,
problem:"Waterlogging",
severity:"Medium"
},

{
lat:22.7350,
lng:75.8450,
problem:"Damaged Road",
severity:"Low"
}

];


reports.forEach(
addReportMarker
);

}


/* =====================================================
   ROAD MARKERS
===================================================== */

function severityColor(severity){

if(severity === "Critical")
return "#ff1744";

if(severity === "High")
return "#ff8c00";

if(severity === "Medium")
return "#ffd
